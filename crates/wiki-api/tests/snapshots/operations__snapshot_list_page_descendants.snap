{
  "access": "Read",
  "body": null,
  "description": "Возвращает подстраницы всех уровней по адресу (`slug`) страницы; пустой `slug` — страницы от корня Вики. Выдача постраничная: следующую страницу запрашивайте с `cursor` из `next_cursor`, пока он не станет null.",
  "docs_url": "https://yandex.ru/support/wiki/ru/api-ref/pages/pages__descendants_by_slug",
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "actuality": {
        "description": "Только актуальные (`actual`) или только устаревшие (`obsolete`) страницы.",
        "enum": [
          "actual",
          "obsolete"
        ],
        "type": "string"
      },
      "cursor": {
        "description": "Курсор страницы выдачи: `next_cursor` (или `prev_cursor`) из предыдущего ответа. Без параметра возвращается первая страница.",
        "type": "string"
      },
      "include_self": {
        "default": false,
        "description": "Если `true`, включить в ответ и саму страницу.",
        "type": "boolean"
      },
      "page_size": {
        "default": 50,
        "description": "Число результатов на странице выдачи. Ответ может содержать меньше; выдача закончилась, когда `next_cursor` равен null.",
        "maximum": 100,
        "minimum": 1,
        "type": "integer"
      },
      "show_all": {
        "default": false,
        "description": "Если `true`, администратор организации или пространства получает все подстраницы, включая недоступные ему по обычным правам. От корня Вики режим доступен только администратору организации.",
        "type": "boolean"
      },
      "slug": {
        "description": "Адрес страницы относительно корня Вики, например `team/project` (не полный URL). Пустая строка — страницы от корня Вики.",
        "type": "string"
      }
    },
    "required": [
      "slug"
    ],
    "type": "object"
  },
